Plecs {
Name "Hartmann_DeltaSwitch_PhaseLoss"
Version "4.9"
CircuitModel "ContStateSpace"
StartTime "0"
TimeSpan "Tstop"
Solver "auto"
MaxStep "1/(fsw*10)"
InitStep "-1"
FixedStep "1e-7"
Refine "1"
ZCStepSize "1e-10"
RelTol "1e-6"
AbsTol "1e-8"
MaxConsecutiveZCs "1000"
InitializationCommands "% Hartmann et al., IEEE TIE 2012, Fig.1(b), Fig.6, Table III.\n% Paper simulation: 115 Vrms phase, 800 Hz, 400 Vdc, 5 kW, 72 kHz, 330 uH.\nVph=115; fline=800; Vref=400; Pnom=5000; fsw=72000;\nLboost=330e-6; Cdc=18*82e-6; Rload=Vref^2/Pnom;\n% Engineering assumptions: small winding resistance and ideal semiconductor losses.\nRL=0.02; Rsw=0.001; Rd=0.001; Vd=0;\n% Physical-unit current gain for ~4 kHz bandwidth; paper kp=0.25 uses unstated scaling.\nKcurrent=2*pi*4000*Lboost;\n% Outer PI: 20 Hz natural frequency, zeta~0.707, conductance output in S.\nKpv=2*0.707*(2*pi*20)*Cdc*Vref/(3*Vph^2);\nKiv=(2*pi*20)^2*Cdc*Vref/(3*Vph^2);\nGmax=0.25; Ginit=Pnom/(3*Vph^2);\n% Precharged capacitor; this baseline is not an inrush/precharge-hardware simulation.\nVinit=400; Tstop=0.12;\nt_loss=0.06;\n"
InitialState "1"
Terminal { Type Output Index "1" }
Schematic {
Location [0, 30; 1500, 1020]
ZoomFactor 1
SliderPosition [0, 0]
ShowBrowser off
Component {
 Type ThreePhaseVoltageSource
 Name "Grid_115Vrms"
 Show on
 Position [100, 190]
 Direction up
 Flipped off
 LabelPosition south
 Parameter { Variable "V" Value "sqrt(2)*Vph" Show off }
 Parameter { Variable "w" Value "fline" Show off }
 Parameter { Variable "phi" Value "pi/2" Show off }
 Parameter { Variable "neutral" Value "1" Show off }

}
