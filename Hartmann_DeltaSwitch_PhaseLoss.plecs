Component {
 Type CScript
 Name "Hartmann_Control"
 Show on
 Position [310, 790]
 Direction up
 Flipped off
 LabelPosition south
 Parameter { Variable "NumInputs" Value "[3 3 1 1]" Show off }
 Parameter { Variable "NumOutputs" Value "[6 3 1]" Show off }
 Parameter { Variable "NumContStates" Value "1" Show off }
 Parameter { Variable "NumDiscStates" Value "0" Show off }
 Parameter { Variable "NumZCSignals" Value "11" Show off }
 Parameter { Variable "DirectFeedthrough" Value "1" Show off }
 Parameter { Variable "Ts" Value "0" Show off }
 Parameter { Variable "TerminalBasedSampleTimes" Value "1" Show off }
 Parameter { Variable "Parameters" Value "Vref,Kcurrent,Kpv,Kiv,Gmax,Ginit" Show off }
 Parameter { Variable "LangStandard" Value "2" Show off }
 Parameter { Variable "GnuExtensions" Value "1" Show off }
 Parameter { Variable "RuntimeCheck" Value "2" Show off }
 Parameter { Variable "Declarations" Value "#include <math.h>\n#define PAR(i) ParamRealData(i,0)\nstatic double limit(double x,double lo,double hi) { return x<lo?lo:(x>hi?hi:x); }\nstatic int a[6]={0,1,1,2,0,2};\nstatic int b[6]={1,0,2,1,2,0};\n" Show off }
 Parameter { Variable "StartFcn" Value "ContState(0)=PAR(5);" Show off }
 Parameter { Variable "OutputFcn" Value "double v[3], vr[3];\ndouble err=PAR(0)-InputSignal(2,0);\ndouble raw=ContState(0)+PAR(2)*err;\ndouble g=limit(raw,0,PAR(4));\ndouble vo=fmax(InputSignal(2,0),50.0);\nfor(int k=0;k<3;k++) {\n v[k]=InputSignal(1,k);\n double ir=g*v[k];\n OutputSignal(1,k)=ir;\n vr[k]=v[k]-PAR(1)*(ir-InputSignal(0,k));\n ZCSignal(6+k)=v[k];\n}\nfor(int k=0;k<6;k++) {\n double z=InputSignal(3,0)-(vr[a[k]]-vr[b[k]])/vo;\n ZCSignal(k)=z;\n if(IsMajorStep) {\n   /* Table III: same-sign phase pair is clamped OFF;\n      negative-to-positive device is held ON. */\n   if(v[a[k]]*v[b[k]]>=0) OutputSignal(0,k)=0;\n   else if(v[a[k]]<0) OutputSignal(0,k)=1;\n   else OutputSignal(0,k)=z>0;\n }\n}\nOutputSignal(2,0)=g;\nZCSignal(9)=raw;\nZCSignal(10)=raw-PAR(4);\n" Show off }
 Parameter { Variable "DerivativeFcn" Value "double e=PAR(0)-InputSignal(2,0);\ndouble raw=ContState(0)+PAR(2)*e;\ndouble d=PAR(3)*e;\nif((raw<=0 && d<0)||(raw>=PAR(4) && d>0)) d=0;\nContDeriv(0)=d;\n" Show off }
 Parameter { Variable "UpdateFcn" Value "" Show off }
 Parameter { Variable "TerminateFcn" Value "" Show off }

}
